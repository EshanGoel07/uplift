{
  "name": "uplift-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "python scripts/split_results.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
